{
  "name": "comiscopio",
  "version": "0.2.0",
  "description": "Visor de comics y manga",
  "author": "Rigoberto L. Salgado Reyes <rlsalgado2006@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/Rigo85/Comiscopio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rigo85/Comiscopio.git"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "npm-run-all build:worker build:doc-worker build:ace-helper start:dev",
    "start:dev": "run-p --race start:angular watch:electron start:electron",
    "start:angular": "ng serve --port 4200",
    "start:electron": "wait-on http://localhost:4200 dist-electron/electron/main.js && electron --no-sandbox .",
    "build:worker": "cmake -B native/worker/build -S native/worker -DCMAKE_BUILD_TYPE=Release && cmake --build native/worker/build -j\"$(nproc)\"",
    "build:doc-worker": "cmake -B native/doc-worker/build -S native/doc-worker -DCMAKE_BUILD_TYPE=Release && cmake --build native/doc-worker/build -j\"$(nproc)\"",
    "build:ace-helper": "cmake -B native/ace-helper/build -S native/ace-helper -DCMAKE_BUILD_TYPE=Release && cmake --build native/ace-helper/build -j\"$(nproc)\"",
    "build:app": "npm-run-all build:angular build:electron",
    "build:portable": "bash native/deps/build-linux-x64.sh",
    "build:release": "npm-run-all build build:portable",
    "clean:worker": "rm -rf native/worker/build",
    "clean:doc-worker": "rm -rf native/doc-worker/build",
    "clean:ace-helper": "rm -rf native/ace-helper/build",
    "clean:native": "npm run clean:worker && npm run clean:doc-worker && npm run clean:ace-helper",
    "clean": "rm -rf dist dist-electron release",
    "clean:all": "npm run clean && npm run clean:native",
    "build:native-linux": "bash native/deps/build-linux-x64.sh",
    "full:package-linux": "npm run build:native-linux && npm run dist:linux",
    "build": "npm-run-all build:worker build:doc-worker build:ace-helper build:app",
    "build:angular": "ng build --configuration production --base-href ./",
    "build:electron": "tsc -p tsconfig.electron.json",
    "watch:electron": "tsc -p tsconfig.electron.json --watch",
    "test:unit": "vitest run",
    "test:native": "ctest --test-dir native/worker/build --output-on-failure",
    "test:workers": "bash test/workers/run-worker-tests.sh",
    "test:all": "npm-run-all build test:unit test:native build:portable test:workers",
    "test": "npm run test:all",
    "test:watch": "vitest",
    "test:functional": "bash test/workers/run-distro-tests.sh",
    "pack": "npm run build:release && NODE_NO_WARNINGS=1 electron-builder --dir",
    "dist": "npm run build:release && NODE_NO_WARNINGS=1 electron-builder",
    "dist:linux": "npm run build:release && NODE_NO_WARNINGS=1 electron-builder --linux",
    "dist:win": "npm run build && NODE_NO_WARNINGS=1 electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.8.0",
    "image-size": "^2.0.2",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^5.5.207",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.0",
    "@electron/rebuild": "^4.0.3",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/image-size": "^0.7.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "jsdom": "^28.0.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.comiscopio.app",
    "productName": "Comiscopio",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/Comiscopio/browser/**/*",
      "!node_modules/**/*.md",
      "!node_modules/**/*.ts",
      "!node_modules/**/*.map"
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "fileAssociations": [
      {
        "ext": "cbz",
        "name": "Comic Archive",
        "description": "Comic/Manga archive",
        "mimeType": "application/x-cbz",
        "role": "Viewer"
      },
      {
        "ext": "cbr",
        "name": "Comic Archive",
        "description": "Comic/Manga archive",
        "mimeType": "application/x-cbr",
        "role": "Viewer"
      },
      {
        "ext": "cb7",
        "name": "Comic Archive",
        "description": "Comic/Manga archive",
        "mimeType": "application/x-cb7",
        "role": "Viewer"
      },
      {
        "ext": "cbt",
        "name": "Comic Archive",
        "description": "Comic/Manga archive",
        "mimeType": "application/x-cbt",
        "role": "Viewer"
      },
      {
        "ext": "cba",
        "name": "Comic Archive",
        "description": "Comic/Manga archive",
        "mimeType": "application/x-cba",
        "role": "Viewer"
      },
      {
        "ext": "ace",
        "name": "Comic Archive",
        "description": "Comic/Manga archive",
        "mimeType": "application/x-ace-compressed",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      },
      {
        "ext": "djvu",
        "name": "DjVu Document",
        "mimeType": "image/vnd.djvu",
        "role": "Viewer"
      },
      {
        "ext": "djv",
        "name": "DjVu Document",
        "mimeType": "image/vnd.djvu",
        "role": "Viewer"
      },
      {
        "ext": "epub",
        "name": "EPUB Document",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      },
      {
        "ext": "xps",
        "name": "XPS Document",
        "mimeType": "application/vnd.ms-xpsdocument",
        "role": "Viewer"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "resources/icon-1024.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "comiscopio"
        }
      },
      "mimeTypes": [
        "application/x-cbz",
        "application/x-cbr",
        "application/x-cb7",
        "application/x-cbt",
        "application/x-cba",
        "application/x-ace-compressed",
        "application/pdf",
        "image/vnd.djvu",
        "application/epub+zip",
        "application/vnd.ms-xpsdocument"
      ],
      "extraResources": [
        {
          "from": "native/vendor/linux-x64",
          "to": "native"
        },
        {
          "from": "resources/icon-1024.png",
          "to": "icon.png"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "extraFiles": [
      {
        "from": "scripts/uninstall.sh",
        "to": "uninstall.sh"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/7zip-bin/**",
      "node_modules/node-unrar-js/**"
    ]
  }
}
