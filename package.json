{
  "name": "comiscopio",
  "version": "0.1.0",
  "description": "Comic and manga viewer — Electron + Angular",
  "author": "Comiscopio",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "npm-run-all build:worker start:dev",
    "start:dev": "run-p --race start:angular watch:electron start:electron",
    "start:angular": "ng serve --port 4200",
    "start:electron": "wait-on http://localhost:4200 dist-electron/electron/main.js && electron --no-sandbox .",
    "build:worker": "cmake -B native/worker/build -S native/worker -DCMAKE_BUILD_TYPE=Release && cmake --build native/worker/build -j\"$(nproc)\"",
    "build": "npm-run-all build:angular build:electron",
    "build:angular": "ng build --configuration production --base-href ./",
    "build:electron": "tsc -p tsconfig.electron.json",
    "watch:electron": "tsc -p tsconfig.electron.json --watch",
    "test": "ng test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.8.0",
    "image-size": "^2.0.2",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^5.5.207",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.0",
    "@electron/rebuild": "^4.0.3",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/image-size": "^0.7.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "jsdom": "^28.0.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.comiscopio.app",
    "productName": "Comiscopio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/Comiscopio/browser/**/*",
      "!node_modules/**/*.md",
      "!node_modules/**/*.ts",
      "!node_modules/**/*.map"
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "fileAssociations": [
      {
        "ext": [
          "cbz",
          "cbr",
          "cb7"
        ],
        "name": "Comic Archive",
        "description": "Comic/Manga archive",
        "mimeType": "application/x-cbz",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "resources/icon.png",
      "mimeTypes": [
        "application/x-cbz",
        "application/x-cbr",
        "application/x-cb7",
        "application/pdf"
      ]
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/7zip-bin/**",
      "node_modules/node-unrar-js/**"
    ]
  }
}
