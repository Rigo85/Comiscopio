{
  "name": "comiscopio",
  "version": "0.3.0",
  "description": "Visor de cómics y manga con lectura LTR, RTL y vertical, miniaturas y progreso guardado.",
  "author": "Rigoberto L. Salgado Reyes <rlsalgado2006@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/Rigo85/Comiscopio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rigo85/Comiscopio.git"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "npm-run-all build:native start:dev",
    "start:dev": "run-p --race start:angular watch:electron start:electron",
    "start:angular": "ng serve --port 4200",
    "start:electron": "wait-on http://localhost:4200 dist-electron/electron/main.js && electron --no-sandbox .",
    "build:worker": "cmake -B native/worker/build -S native/worker -DCMAKE_BUILD_TYPE=Release && cmake --build native/worker/build -j\"$(nproc)\"",
    "build:doc-worker": "cmake -B native/doc-worker/build -S native/doc-worker -DCMAKE_BUILD_TYPE=Release && cmake --build native/doc-worker/build -j\"$(nproc)\"",
    "build:ace-helper": "cmake -B native/ace-helper/build -S native/ace-helper -DCMAKE_BUILD_TYPE=Release && cmake --build native/ace-helper/build -j\"$(nproc)\"",
    "build:app": "npm-run-all build:angular build:electron",
    "build:portable": "node scripts/build-portable.cjs",
    "build:release": "npm-run-all build:app build:portable",
    "clean:worker": "rm -rf native/worker/build",
    "clean:doc-worker": "rm -rf native/doc-worker/build",
    "clean:ace-helper": "rm -rf native/ace-helper/build",
    "clean:native": "npm run clean:worker && npm run clean:doc-worker && npm run clean:ace-helper",
    "clean": "rm -rf dist dist-electron release",
    "clean:all": "npm run clean && npm run clean:native",
    "build:native-linux": "bash native/deps/build-linux-x64.sh",
    "full:package-linux": "npm run dist:linux",
    "build": "npm-run-all build:native build:app",
    "build:angular": "ng build --configuration production --base-href ./",
    "build:electron": "tsc -p tsconfig.electron.json",
    "watch:electron": "tsc -p tsconfig.electron.json --watch",
    "test:unit": "vitest run",
    "test:native": "ctest --test-dir native/worker/build --output-on-failure",
    "test:workers": "bash test/workers/run-worker-tests.sh",
    "test:all": "node scripts/test-all.cjs",
    "test": "npm run test:all",
    "test:watch": "vitest",
    "test:functional": "bash test/workers/run-distro-tests.sh",
    "pack": "npm run build:release && electron-builder --dir --publish never",
    "dist": "npm run build:release && electron-builder --publish never",
    "dist:linux": "npm run build:release && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "postinstall": "electron-builder install-app-deps",
    "test:database": "npm run build:electron && node scripts/test-database.cjs",
    "test:workers:portable": "node test/workers/native.test.cjs",
    "build:native": "node scripts/build-native.cjs",
    "prebuild:angular": "node scripts/generate-metadata.cjs",
    "prebuild:electron": "node scripts/generate-metadata.cjs",
    "test:packaged": "node test/integration/packaged-app.test.cjs",
    "test:fixtures": "node scripts/prepare-ace-fixture.cjs",
    "test:linux-artifacts": "node test/integration/linux-artifacts.test.cjs",
    "test:windows-artifacts": "node test/integration/windows-artifacts.test.cjs",
    "test:windows-processes": "node test/integration/windows-processes.test.cjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "better-sqlite3": "^13.0.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@types/better-sqlite3": "^9.6.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^9.0.3",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.comiscopio.app",
    "productName": "Comiscopio",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/Comiscopio/browser/**/*",
      "!node_modules/**/*.md",
      "!node_modules/**/*.ts",
      "!node_modules/**/*.map"
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "fileAssociations": [
      {
        "ext": "cbz",
        "name": "Comic Archive",
        "description": "Comic/Manga archive",
        "mimeType": "application/x-cbz",
        "role": "Viewer"
      },
      {
        "ext": "cbr",
        "name": "Comic Archive",
        "description": "Comic/Manga archive",
        "mimeType": "application/x-cbr",
        "role": "Viewer"
      },
      {
        "ext": "cb7",
        "name": "Comic Archive",
        "description": "Comic/Manga archive",
        "mimeType": "application/x-cb7",
        "role": "Viewer"
      },
      {
        "ext": "cbt",
        "name": "Comic Archive",
        "description": "Comic/Manga archive",
        "mimeType": "application/x-cbt",
        "role": "Viewer"
      },
      {
        "ext": "cba",
        "name": "Comic Archive",
        "description": "Comic/Manga archive",
        "mimeType": "application/x-cba",
        "role": "Viewer"
      },
      {
        "ext": "ace",
        "name": "Comic Archive",
        "description": "Comic/Manga archive",
        "mimeType": "application/x-ace-compressed",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      },
      {
        "ext": "djvu",
        "name": "DjVu Document",
        "mimeType": "image/vnd.djvu",
        "role": "Viewer"
      },
      {
        "ext": "djv",
        "name": "DjVu Document",
        "mimeType": "image/vnd.djvu",
        "role": "Viewer"
      },
      {
        "ext": "epub",
        "name": "EPUB Document",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      },
      {
        "ext": "xps",
        "name": "XPS Document",
        "mimeType": "application/vnd.ms-xpsdocument",
        "role": "Viewer"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "resources/icon-1024.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "comiscopio"
        }
      },
      "mimeTypes": [
        "application/x-cbz",
        "application/x-cbr",
        "application/x-cb7",
        "application/x-cbt",
        "application/x-cba",
        "application/x-ace-compressed",
        "application/pdf",
        "image/vnd.djvu",
        "application/epub+zip",
        "application/vnd.ms-xpsdocument"
      ],
      "extraResources": [
        {
          "from": "native/vendor/linux-x64",
          "to": "native"
        },
        {
          "from": "resources/icon-1024.png",
          "to": "icon.png"
        }
      ],
      "extraFiles": [
        {
          "from": "scripts/uninstall.sh",
          "to": "uninstall.sh"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "extraResources": [
        {
          "from": "native/vendor/win32-x64",
          "to": "native"
        }
      ]
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ]
  },
  "engines": {
    "node": "^24.18.1",
    "npm": ">=11 <12"
  }
}
