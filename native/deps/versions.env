# Comiscopio native worker build — version pins
#
# The base Docker image is the primary version anchor.
# It fixes glibc (2.35), GCC (11), and all apt package versions.
# Ubuntu 22.04 LTS is supported until April 2027.

UBUNTU_IMAGE=ubuntu:22.04

# ── Dynamic deps ─────────────────────────────────────────────────────────────
# Bundled at package time via ldd. Versions are from Ubuntu 22.04 Jammy apt.
#
#   libvips          8.12.1    (image processing pipeline)
#   libarchive       3.6.0     (archive extraction — archive worker)
#   libglib-2.0      2.72.x    (GObject runtime, transitive from libvips)
#   + full transitive tree collected by bundle script

# ── Static deps ───────────────────────────────────────────────────────────────
# Linked into the binary. No .so bundled, no runtime dep.
#
#   libunrar         5.6.6     (RAR extraction — archive worker)
#                              License: UnRAR freeware. Binary distribution
#                              permitted. See LICENSES/unrar.txt.
#
#   libmupdf         1.19.0    (document rasterizer — doc worker)
#   libmupdf-third   1.19.0
#   libjbig2dec      0.20      (JBIG2 codec, MuPDF dep)
#   libgumbo         0.10.1    (HTML5 parser, MuPDF dep for EPUB)
#   libmujs          1.1.3     (JavaScript engine, MuPDF dep for PDF forms)
